# Supabase (Frontend)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# LINE Messaging API
# ⚠️  Token จริงเก็บใน Supabase Dashboard > Edge Functions > Secrets เท่านั้น
# ห้ามใส่ใน .env frontend (จะ expose ต่อ public)
# ชื่อ secret ที่ต้องตั้งใน Supabase:
#   LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
#   LINE_USER_ID=your_line_user_id

# Backup อัตโนมัติขึ้น Google Drive (Edge Function daily-backup)
# ⚠️  เก็บใน Supabase Dashboard > Edge Functions > Secrets เช่นกัน ห้ามใส่ใน .env frontend
# วิธีตั้งค่าแบบละเอียด (สร้าง Service Account ฯลฯ) ดู BACKUP-AUTO-SETUP.md
#   GOOGLE_SA_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
#   GOOGLE_SA_PRIVATE_KEY=your_service_account_private_key
#   GOOGLE_DRIVE_FOLDER_ID=your_target_drive_folder_id
